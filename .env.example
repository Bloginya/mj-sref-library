# Admin panel (Keystatic) in production — use ONE of the options:

# Option A: Keystatic Cloud (easiest). Format: team-name/project-name
# PUBLIC_KEYSTATIC_CLOUD_PROJECT=

# Option B: GitHub mode (your own GitHub App)
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

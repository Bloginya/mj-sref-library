---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="nf theme-black">
    <h1 class="h-xl" data-split>404</h1>
    <p data-reveal style="--d:2">This page doesn’t exist (anymore).</p>
    <a href="/" class="btn" data-reveal style="--d:3">Back home ➺</a>
  </section>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; place-content: center; justify-items: center; gap: 24px; text-align: center; padding: var(--gutter); }
</style>
